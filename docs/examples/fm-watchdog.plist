<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd user agent template for bin/fm-watchdog-check.sh (docs/watchdog.md).
  bin/fm-watchdog-install.sh fills the tokens between at signs and writes the result to
  ~/Library/LaunchAgents; do not load this file directly.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>@LABEL@</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>@FM_ROOT@/bin/fm-watchdog-check.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>FM_HOME</key>
    <string>@FM_HOME@</string>
    <key>PATH</key>
    <string>@PATH@</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>@FM_HOME@</string>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>@INTERVAL@</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>@FM_HOME@/state/.watchdog.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>@FM_HOME@/state/.watchdog.launchd.log</string>
</dict>
</plist>
