 }
 
 fm_test_reap_processes() {
-  local pidfile needle pid pgid
+  local pidfile needle mode pid pgid
   [ -f "$FM_TEST_PROCESS_REGISTRY" ] || return 0
-  while IFS=$'\t' read -r pidfile needle; do
