{
  "broken": "<!doctype html><html><head><meta charset=\"utf-8\"><title>Decision board live validation</title><style>body{font:17px system-ui;color:#203045;background:#f4f6fa;margin:32px;max-width:750px}h1{font-size:28px}form{padding:20px;background:white;border:1px solid #c8d2df;border-radius:10px}button{display:block;margin-top:18px;padding:10px 16px;font:inherit}label{display:block;margin:12px 0}</style></head><body><h1>Decision: repair lane d5's branch pointer</h1><form data-lavish-question=\"d5-branch-pointer\" onsubmit=\"event.preventDefault(); const c=new FormData(event.currentTarget).get('d5-branch-pointer'); if(c) window.lavish.queuePrompt('Decision: '+c,{tag:'choice',text:'Repair lane d5&#x27;s branch pointer: '+c,data:{question:'d5-branch-pointer',answer:c}});\"><p>Choose how to handle the broken pointer.</p><label><input type=\"radio\" name=\"d5-branch-pointer\" value=\"Repair it\" required> Repair it</label><label><input type=\"radio\" name=\"d5-branch-pointer\" value=\"Leave it\"> Leave it</label><button type=\"submit\">Queue answer</button></form></body></html>",
  "sound": "<!doctype html><html><head><meta charset=\"utf-8\"><title>Decision board live validation</title><style>body{font:17px system-ui;color:#203045;background:#f4f6fa;margin:32px;max-width:750px}h1{font-size:28px}form{padding:20px;background:white;border:1px solid #c8d2df;border-radius:10px}button{display:block;margin-top:18px;padding:10px 16px;font:inherit}label{display:block;margin:12px 0}</style></head><body><h1>Decision: repair lane d5's branch pointer</h1><form data-lavish-question=\"d5-branch-pointer\" onsubmit=\"event.preventDefault(); const c=new FormData(event.currentTarget).get('d5-branch-pointer'); if(c) window.lavish.queuePrompt('Decision: '+c,{tag:'choice',text:&quot;Repair lane d5's branch pointer: &quot;+c,data:{question:'d5-branch-pointer',answer:c}});\"><p>Choose how to handle the broken pointer.</p><label><input type=\"radio\" name=\"d5-branch-pointer\" value=\"Repair it\" required> Repair it</label><label><input type=\"radio\" name=\"d5-branch-pointer\" value=\"Leave it\"> Leave it</label><button type=\"submit\">Queue answer</button></form><!--\nDrop-in guard for any Lavish board that carries a form. Paste this script into the board once.\nWithout it, a form whose handler is missing or broken submits natively: the sandboxed artifact frame\nnavigates to a URL with no Lavish load token, Lavish answers 409 \"no longer current\", a reload does\nnot repair it, and the answer is gone with nothing said.\nWith it, the native submit is cancelled, the form shows a visible error, and an error prompt is queued\nfor the agent. A form whose handler ran and cancelled its own submit is left alone.\nbin/fm-procevent-lavish.sh check warns when a board has inline form handlers and no element carrying\nthe data-fm-lavish-form-guard attribute below.\n-->\n<script data-fm-lavish-form-guard>\n(function () {\n  document.addEventListener(\"submit\", function (event) {\n    if (event.defaultPrevented) return;\n    event.preventDefault();\n    var form = event.target;\n    var question = (form && form.getAttribute && form.getAttribute(\"data-lavish-question\")) || \"\";\n    var notice = document.createElement(\"div\");\n    notice.setAttribute(\"role\", \"alert\");\n    notice.style.cssText = \"margin:8px 0;padding:8px 12px;border:2px solid #b00020;background:#fff0f0;color:#600010;font:14px/1.4 sans-serif\";\n    notice.textContent = \"This answer was NOT recorded: the form's page script is broken. Tell the agent\" +\n      (question ? \" (form \" + question + \").\" : \".\");\n    (form && form.appendChild ? form : document.body).appendChild(notice);\n    try {\n      if (window.lavish && window.lavish.queuePrompt) {\n        window.lavish.queuePrompt(\"Form \" + question + \" failed: its page script is broken and no answer was queued\", {\n          tag: \"form-error\",\n          text: \"Form failed: \" + question,\n          element: form,\n          data: { question: question, error: \"handler-broken\" }\n        });\n      }\n    } catch (ignored) { /* the visible notice above already stands */ }\n  }, false);\n})();\n</script>\n</body></html>",
