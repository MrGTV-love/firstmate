completing-command: FM_FRICTION_OPERATION_ID=8063cd61-8693-44ed-9e60-e65a3c22e75c FM_FRICTION_EPISODE_ID=8063cd61-8693-44ed-9e60-e65a3c22e75c echo do-the-thing
caller-rc-after-fm_refuse=0

## 2. human-only refusal
REFUSED: guard=FM-SMOKE rule=other-rule missing=missing Y
human-only-exit: Who owns Z?
rc=0

