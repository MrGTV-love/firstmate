#!/usr/bin/env bash
set -u
unset GIT_CONFIG_COUNT GIT_CONFIG_KEY_0 GIT_CONFIG_VALUE_0
ours='/Users/charlesabrooker/.no-mistakes/worktrees/32d18ed9638d/01M48Z9Z3HQ68ZTKMVC9XJB2G6/.test-herdr-recovery-home/state/hrcompat.git-hooks'
name=${0##*/}
orig=$(unset GIT_CONFIG_PARAMETERS; git rev-parse --path-format=absolute --git-path hooks) || {
  echo "fm-git-strip-ai-trailers: cannot resolve this repository's hooks directory; refusing to skip its $name hook" >&2
  exit 1
}
if [ "$orig" = "$ours" ]; then
  exit 0
fi
if [ -x "$orig/$name" ]; then
  exec "$orig/$name" "$@"
fi
