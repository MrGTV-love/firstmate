#!/usr/bin/env python3
# Disposable GitHub REST double for `gh api -i` (the forge is external; firstmate code stays real).
import hashlib, json, os, sys, time
args = sys.argv[1:]
assert args[:2] == ['api', '-i'], args
double = json.load(open(os.environ['GH_DOUBLE']))
path = '/' + args[-1].lstrip('/')
with open(os.environ['GH_REQUESTS'], 'a') as s: s.write(path + '\n')
if '/check-runs' in path:
    value = {'check_runs': double['checks'].get(path.split('/commits/')[1].split('/')[0], [])}
elif '/statuses' in path:
    value = []
elif '/pulls?' in path:
    value = double['pulls']
elif '/pulls/' in path and path.rsplit('/', 1)[1].isdigit():
    value = next(p for p in double['pulls'] if str(p['number']) == path.rsplit('/', 1)[1])
else:
    with open(os.environ['GH_REQUESTS'] + '.unknown', 'a') as s: s.write(path + '\n')
    value = []
body = json.dumps(value)
etag = '"' + hashlib.sha1(body.encode()).hexdigest()[:16] + '"'
rate = f"X-Ratelimit-Limit: 5000\r\nX-Ratelimit-Remaining: 4000\r\nX-Ratelimit-Reset: {int(time.time()) + 3600}\r\nX-Ratelimit-Resource: core\r\n"
sys.stdout.write('HTTP/2.0 200 OK\r\nEtag: ' + etag + '\r\n' + rate + '\r\n' + body)
