<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd user agent template for bin/fm-landing-loop.py.
  bin/fm-landing-loop-install.sh fills the tokens between at signs and writes the result to
  ~/Library/LaunchAgents; do not load this file directly.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.firstmate.landing-loop.100872637</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>python3</string>
    <string>FM_ROOT/bin/fm-landing-loop.py</string>
    <string>step</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>FM_HOME</key>
    <string>LAB_HOME</string>
    <key>PATH</key>
    <string>PATH_REDACTED</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>LAB_HOME</string>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>90</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>LAB_HOME/state/.landing-loop.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>LAB_HOME/state/.landing-loop.launchd.log</string>
</dict>
</plist>
