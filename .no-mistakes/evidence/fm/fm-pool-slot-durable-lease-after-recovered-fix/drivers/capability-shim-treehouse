#!/usr/bin/env bash
# Capability-only shim: answers 'capabilities --json' as a schema-2 provider would
# (no such build exists yet); every other command runs the REAL installed treehouse unchanged.
if [ "${1:-}" = capabilities ]; then
  printf '%s\n' '{"schema_version":2,"version":"v3.1.7-fm.shim","persistent_recovered_leases":true,"recovered_quarantine_holder":"quarantined: persistent recovered lease"}'
  exit 0
fi
exec /Users/charlesabrooker/.local/bin/treehouse "$@"
